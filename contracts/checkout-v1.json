        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "UUID-form key scoped to purchase creation in the initial single synthetic client namespace. Canonical semantic payload is parsed sku and quantity. Retention/multi-client expansion requires M1.3 review. Retain scope/key/canonical payload without automatic deletion in initial M1.3; matching replay returns 202, original Location and current snapshot even if terminal. Parsed UUID case is insignificant; parsed sku and integer quantity define equivalence.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
