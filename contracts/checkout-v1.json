    "/api/v1/purchases": {
      "post": {
        "operationId": "submitPurchase",
        "summary": "Accept purchase workflow (reserved contract)",
        "description": "Reserved M1.3. Accept only with durable workflow intent. No client amount, currency, payment result, or cancellation. Inventory selects price at reservation. Reject conflicting idempotency payload with 409; matching replay identifies same purchase and returns current state, not necessarily original response snapshot. Recovery, compensation and notification intent are M1.3.",
        "x-aegis-milestone": "M1.3",
        "x-aegis-implementation-status": "not-implemented",
        "tags": [
          "M1.3"
        ],
        "responses": {
          "202": {
            "description": "Durably accepted or matching replay of the same purchase; Location identifies current status, including if terminal on replay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Purchase"
                },
                "example": {
                  "purchaseId": "11111111-1111-4111-8111-111111111111",
                  "sku": "AEGIS_ITEM",
                  "quantity": 2,
                  "amountMinor": null,
                  "currency": null,
                  "createdAt": "2026-10-17T00:00:00Z",
                  "updatedAt": "2026-10-17T00:00:01Z",
                  "state": "PROCESSING",
                  "step": "RESERVATION_PENDING",
                  "compensationPending": false,
                  "paymentOutcomeKnown": false
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Relative URI of this resource.",
                "required": true,
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
