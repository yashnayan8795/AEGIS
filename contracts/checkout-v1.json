  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "IDEMPOTENCY_KEY_REUSED",
              "INTERNAL_ERROR",
              "INVALID_REQUEST",
              "PURCHASE_NOT_FOUND",
              "SERVICE_UNAVAILABLE",
              "UNSUPPORTED_MEDIA_TYPE"
            ]
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "description": "RFC 9457-style response. HTTP status and status member must agree. code and violations are Aegis extensions. Never expose SQL, credentials, or stack traces. Consumers must tolerate unknown extension fields."
      },
      "PurchaseRequest": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": [
          "sku",
          "quantity"
        ],
        "additionalProperties": false
      },
      "Purchase": {
        "type": "object",
        "properties": {
          "purchaseId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "amountMinor": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 1,
            "maximum": 9223372036854775807,
            "description": "Positive signed 64-bit integer minor units when present; range 1..9223372036854775807. No float, wraparound, saturation, rounding, or negative/zero amount. Nullable fields allow null only as explicitly constrained by the containing schema."
          },
          "currency": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "INR",
              null
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "PROCESSING",
              "COMPENSATING",
              "CONFIRMED",
              "FAILED",
              "REQUIRES_ATTENTION"
            ]
          },
          "step": {
            "type": "string",
            "enum": [
              "RESERVATION_PENDING",
              "PAYMENT_PENDING",
              "INVENTORY_COMMIT_PENDING",
              "COMPENSATION_PENDING",
              "SETTLED"
            ],
            "description": "Outstanding work. SETTLED is permitted only for CONFIRMED or FAILED. REQUIRES_ATTENTION retains its outstanding step and flags."
          },
          "paymentOutcomeKnown": {
            "type": "boolean",
            "description": "True only for a durably observed definitive charge outcome; false does not imply failure or prove absence of a charge."
          },
          "compensationPending": {
            "type": "boolean",
            "description": "True while cleanup/refund/uncertain-effects reconciliation remains outstanding; false alone never proves purchase success."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": " Finite UTC RFC 3339 instant, supported years 0001..9999. No infinity; cross-field ordering is a persistence/runtime invariant."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC; must be greater than or equal to createdAt. Cross-field time ordering is a runtime invariant. Finite UTC RFC 3339 instant, supported years 0001..9999. No infinity; cross-field ordering is a persistence/runtime invariant."
          }
        },
        "required": [
          "purchaseId",
          "sku",
          "quantity",
          "amountMinor",
          "currency",
          "state",
          "step",
          "paymentOutcomeKnown",
          "compensationPending",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false,
        "description": "Stored purchase snapshot for M1.2 query and reserved M1.3 submission/status; workflow execution is not implemented by contract preparation. The oneOf matrix enumerates all valid exposed snapshots, not execution algorithms. paymentOutcomeKnown means Checkout has durably established a definitive charge outcome (SUCCEEDED or DECLINED); false includes no charge submitted, PENDING, or lost/uncertain response and never means decline. compensationPending means unresolved inventory cleanup, refund, or reconciliation obligations; not just a refund request in flight. FAILED requires all obligations settled and no delayed charge can still create an unaccounted effect. Historical terminal payment knowledge remains true after refund; refund does not erase charge success. No production seeds or unconditional progress guarantee. Compensation may have both price fields null while resolving cleanup for a reservation whose response/price was never established; paymentOutcomeKnown must then be false.",
        "oneOf": [
          {
            "title": "PROCESSING / RESERVATION_PENDING",
            "properties": {
              "state": {
                "const": "PROCESSING"
              },
              "step": {
                "const": "RESERVATION_PENDING"
              },
              "compensationPending": {
                "const": false
              },
              "paymentOutcomeKnown": {
                "const": false
              },
              "amountMinor": {
                "type": "null"
              },
              "currency": {
                "type": "null"
              }
            },
            "required": [
              "state",
              "step",
              "compensationPending",
              "paymentOutcomeKnown",
              "amountMinor",
              "currency"
            ]
          },
          {
            "title": "PROCESSING / PAYMENT_PENDING",
            "properties": {
              "state": {
                "const": "PROCESSING"
              },
              "step": {
                "const": "PAYMENT_PENDING"
              },
              "compensationPending": {
                "const": false
              },
              "paymentOutcomeKnown": {
                "const": false
              },
              "amountMinor": {
                "type": "integer"
              },
              "currency": {
                "const": "INR"
              }
            },
            "required": [
              "state",
              "step",
              "compensationPending",
              "paymentOutcomeKnown",
              "amountMinor",
              "currency"
            ]
          },
          {
            "title": "PROCESSING / INVENTORY_COMMIT_PENDING",
            "properties": {
              "state": {
                "const": "PROCESSING"
              },
              "step": {
                "const": "INVENTORY_COMMIT_PENDING"
              },
              "compensationPending": {
                "const": false
              },
              "paymentOutcomeKnown": {
                "const": true
              },
              "amountMinor": {
                "type": "integer"
              },
              "currency": {
                "const": "INR"
              }
            },
            "required": [
              "state",
              "step",
              "compensationPending",
              "paymentOutcomeKnown",
              "amountMinor",
              "currency"
            ]
          },
          {
            "title": "COMPENSATING / COMPENSATION_PENDING",
            "properties": {
              "state": {
                "const": "COMPENSATING"
              },
              "step": {
                "const": "COMPENSATION_PENDING"
              },
              "compensationPending": {
                "const": true
              }
            },
            "required": [
              "state",
              "step",
              "compensationPending"
            ]
          },
          {
            "title": "CONFIRMED / SETTLED",
            "properties": {
              "state": {
                "const": "CONFIRMED"
              },
              "step": {
                "const": "SETTLED"
              },
              "compensationPending": {
                "const": false
              },
              "paymentOutcomeKnown": {
                "const": true
              },
              "amountMinor": {
                "type": "integer"
              },
              "currency": {
                "const": "INR"
              }
            },
            "required": [
              "state",
              "step",
              "compensationPending",
              "paymentOutcomeKnown",
              "amountMinor",
              "currency"
            ]
          },
          {
            "title": "FAILED / SETTLED",
            "properties": {
              "state": {
                "const": "FAILED"
              },
              "step": {
                "const": "SETTLED"
              },
              "compensationPending": {
                "const": false
              }
            },
            "required": [
              "state",
              "step",
              "compensationPending"
            ]
          },
          {
            "title": "REQUIRES_ATTENTION / RESERVATION_PENDING",
            "properties": {
              "state": {
                "const": "REQUIRES_ATTENTION"
              },
              "step": {
                "const": "RESERVATION_PENDING"
              },
              "compensationPending": {
                "const": false
              },
              "paymentOutcomeKnown": {
                "const": false
              },
