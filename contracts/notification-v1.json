{
  "openapi": "3.1.0",
  "info": {
    "title": "Aegis Notification API",
    "version": "0.1.0",
    "description": "Aegis authoritative wire contract. M1.2 operations implemented; M1.3 operations reserved and unregistered. Synthetic local trusted environment, no authentication or real provider."
  },
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "servers": [
    {
      "url": "/",
      "description": "Relative service origin; no running server implied."
    }
  ],
  "tags": [
    {
      "name": "M1.2",
      "description": "Implemented M1.2 operation."
    },
    {
      "name": "M1.3",
      "description": "Reserved future workflow contract; implementation prohibited in M1.2."
    }
  ],
  "paths": {
    "/api/v1/notifications": {
      "post": {
        "operationId": "storeNotification",
        "summary": "Store or replay synthetic receipt",
        "description": "Database uniqueness on notificationId is mandatory. Concurrent identical requests create one row: winner returns 201, successful replays return 200. Concurrent conflicting payloads yield one winner and 409 for conflicting requests, without overwriting the winner. Atomically insert-if-absent, then read the committed winner in a valid transaction snapshot and compare parsed semantic fields. Never catch a uniqueness violation and continue querying in an aborted transaction. Transient storage failures may return 503, never a false successful receipt. No cross-service lookup, email, workflow, worker, or outbox. No separate Idempotency-Key header.",
        "x-aegis-milestone": "M1.2",
        "x-aegis-implementation-status": "implemented",
        "tags": [
          "M1.2"
        ],
        "responses": {
          "201": {
            "description": "New notification identity; receipt committed before response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationReceipt"
                },
                "example": {
                  "notificationId": "11111111-1111-4111-8111-111111111111",
                  "purchaseId": "22222222-2222-4222-8222-222222222222",
                  "kind": "PURCHASE_CONFIRMED",
                  "state": "STORED",
                  "createdAt": "2026-10-17T00:00:00Z"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Relative URI of this resource.",
                "required": true,
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              }
            }
          },
          "200": {
            "description": "Same identity and identical semantic payload; return original receipt, including original createdAt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationReceipt"
                },
                "example": {
                  "notificationId": "11111111-1111-4111-8111-111111111111",
                  "purchaseId": "22222222-2222-4222-8222-222222222222",
                  "kind": "PURCHASE_CONFIRMED",
                  "state": "STORED",
                  "createdAt": "2026-10-17T00:00:00Z"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: Malformed, missing, unsupported currency, nonpositive/out-of-range amount/quantity, or unexpected fields.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": 400
                        },
                        "code": {
                          "enum": [
                            "INVALID_REQUEST"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "code"
                      ]
                    }
                  ]
                },
                "examples": {
                  "INVALID_REQUEST": {
                    "summary": "Malformed, missing, unsupported currency, nonpositive/out-of-range amount/quantity, or unexpected fields.",
                    "value": {
                      "type": "about:blank",
                      "title": "Bad Request",
                      "status": 400,
                      "detail": "Malformed, missing, unsupported currency, nonpositive/out-of-range amount/quantity, or unexpected fields.",
                      "instance": "/api/v1/notifications",
                      "code": "INVALID_REQUEST"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "NOTIFICATION_ID_REUSED: Same notificationId, different semantic purchaseId/kind; stored receipt unchanged.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": 409
                        },
                        "code": {
                          "enum": [
                            "NOTIFICATION_ID_REUSED"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "code"
                      ]
                    }
                  ]
                },
                "examples": {
                  "NOTIFICATION_ID_REUSED": {
                    "summary": "Same notificationId, different semantic purchaseId/kind; stored receipt unchanged.",
                    "value": {
                      "type": "about:blank",
                      "title": "Conflict",
                      "status": 409,
                      "detail": "Same notificationId, different semantic purchaseId/kind; stored receipt unchanged.",
                      "instance": "/api/v1/notifications",
                      "code": "NOTIFICATION_ID_REUSED"
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_MEDIA_TYPE: Request media type must be application/json.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": 415
                        },
                        "code": {
                          "enum": [
                            "UNSUPPORTED_MEDIA_TYPE"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "code"
                      ]
                    }
                  ]
                },
                "examples": {
                  "UNSUPPORTED_MEDIA_TYPE": {
                    "summary": "Request media type must be application/json.",
                    "value": {
                      "type": "about:blank",
                      "title": "Unsupported Media Type",
                      "status": 415,
                      "detail": "Request media type must be application/json.",
                      "instance": "/api/v1/notifications",
                      "code": "UNSUPPORTED_MEDIA_TYPE"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: Unexpected internal failure.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": 500
                        },
                        "code": {
                          "enum": [
                            "INTERNAL_ERROR"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "code"
                      ]
                    }
                  ]
                },
                "examples": {
                  "INTERNAL_ERROR": {
                    "summary": "Unexpected internal failure.",
                    "value": {
                      "type": "about:blank",
                      "title": "Internal Server Error",
                      "status": 500,
                      "detail": "Unexpected internal failure.",
                      "instance": "/api/v1/notifications",
                      "code": "INTERNAL_ERROR"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE: Storage/dependency unavailable. A mutation outcome may be unknown; resolve with its original identity.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": 503
                        },
                        "code": {
                          "enum": [
                            "SERVICE_UNAVAILABLE"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "code"
                      ]
                    }
                  ]
                },
                "examples": {
                  "SERVICE_UNAVAILABLE": {
                    "summary": "Storage/dependency unavailable. A mutation outcome may be unknown; resolve with its original identity.",
                    "value": {
                      "type": "about:blank",
                      "title": "Service Unavailable",
                      "status": 503,
                      "detail": "Storage/dependency unavailable. A mutation outcome may be unknown; resolve with its original identity.",
                      "instance": "/api/v1/notifications",
                      "code": "SERVICE_UNAVAILABLE"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationRequest"
              },
              "examples": {
                "newOrReplay": {
                  "summary": "Repeat this semantic payload for 200 after the first 201.",
                  "value": {
                    "notificationId": "11111111-1111-4111-8111-111111111111",
                    "purchaseId": "22222222-2222-4222-8222-222222222222",
                    "kind": "PURCHASE_CONFIRMED"
                  }
                },
                "conflictAfterFirst": {
                  "summary": "Same notification ID with another purchase yields 409 after newOrReplay exists.",
                  "value": {
                    "notificationId": "11111111-1111-4111-8111-111111111111",
                    "purchaseId": "33333333-3333-4333-8333-333333333333",
                    "kind": "PURCHASE_CONFIRMED"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/{notificationId}": {
      "get": {
        "operationId": "getNotification",
        "summary": "Get stored receipt",
        "description": "",
        "x-aegis-milestone": "M1.2",
        "x-aegis-implementation-status": "implemented",
        "tags": [
          "M1.2"
        ],
        "responses": {
          "200": {
            "description": "Existing receipt; STORED is not external delivery or proof of purchase confirmation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationReceipt"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: Malformed, missing, unsupported currency, nonpositive/out-of-range amount/quantity, or unexpected fields.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": 400
                        },
                        "code": {
                          "enum": [
                            "INVALID_REQUEST"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "code"
                      ]
                    }
                  ]
                },
                "examples": {
                  "INVALID_REQUEST": {
                    "summary": "Malformed, missing, unsupported currency, nonpositive/out-of-range amount/quantity, or unexpected fields.",
                    "value": {
                      "type": "about:blank",
                      "title": "Bad Request",
                      "status": 400,
                      "detail": "Malformed, missing, unsupported currency, nonpositive/out-of-range amount/quantity, or unexpected fields.",
                      "instance": "/api/v1/notifications/11111111-1111-4111-8111-111111111111",
                      "code": "INVALID_REQUEST"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "NOTIFICATION_NOT_FOUND: Resource does not exist; absence does not fence a delayed mutation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": 404
                        },
                        "code": {
                          "enum": [
                            "NOTIFICATION_NOT_FOUND"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "code"
                      ]
                    }
                  ]
                },
                "examples": {
                  "NOTIFICATION_NOT_FOUND": {
                    "summary": "Resource does not exist; absence does not fence a delayed mutation.",
                    "value": {
                      "type": "about:blank",
                      "title": "Not Found",
                      "status": 404,
                      "detail": "Resource does not exist; absence does not fence a delayed mutation.",
                      "instance": "/api/v1/notifications/11111111-1111-4111-8111-111111111111",
                      "code": "NOTIFICATION_NOT_FOUND"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: Unexpected internal failure.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": 500
                        },
                        "code": {
                          "enum": [
                            "INTERNAL_ERROR"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "code"
                      ]
                    }
                  ]
                },
                "examples": {
                  "INTERNAL_ERROR": {
                    "summary": "Unexpected internal failure.",
                    "value": {
                      "type": "about:blank",
                      "title": "Internal Server Error",
                      "status": 500,
                      "detail": "Unexpected internal failure.",
                      "instance": "/api/v1/notifications/11111111-1111-4111-8111-111111111111",
                      "code": "INTERNAL_ERROR"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE: Storage/dependency unavailable. A mutation outcome may be unknown; resolve with its original identity.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": 503
                        },
                        "code": {
                          "enum": [
                            "SERVICE_UNAVAILABLE"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "code"
                      ]
                    }
                  ]
                },
                "examples": {
                  "SERVICE_UNAVAILABLE": {
                    "summary": "Storage/dependency unavailable. A mutation outcome may be unknown; resolve with its original identity.",
                    "value": {
                      "type": "about:blank",
                      "title": "Service Unavailable",
                      "status": 503,
                      "detail": "Storage/dependency unavailable. A mutation outcome may be unknown; resolve with its original identity.",
                      "instance": "/api/v1/notifications/11111111-1111-4111-8111-111111111111",
                      "code": "SERVICE_UNAVAILABLE"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "INTERNAL_ERROR",
              "INVALID_REQUEST",
              "NOTIFICATION_ID_REUSED",
              "NOTIFICATION_NOT_FOUND",
              "SERVICE_UNAVAILABLE",
              "UNSUPPORTED_MEDIA_TYPE"
            ]
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "description": "RFC 9457-style response. HTTP status and status member must agree. code and violations are Aegis extensions. Never expose SQL, credentials, or stack traces. Consumers must tolerate unknown extension fields."
      },
      "NotificationRequest": {
        "type": "object",
        "properties": {
          "notificationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "purchaseId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "PURCHASE_CONFIRMED"
            ]
          }
        },
        "required": [
          "notificationId",
          "purchaseId",
          "kind"
        ],
        "additionalProperties": false,
        "description": "Semantic payload is purchaseId and kind, compared after parsing UUIDs/enums; notificationId is identity. Unknown fields are rejected. JSON whitespace and property order have no semantic effect."
      },
      "NotificationReceipt": {
        "type": "object",
        "properties": {
          "notificationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "purchaseId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "PURCHASE_CONFIRMED"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "STORED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": " Finite UTC RFC 3339 instant, supported years 0001..9999. No infinity; cross-field ordering is a persistence/runtime invariant."
          }
        },
        "required": [
          "notificationId",
          "purchaseId",
          "kind",
          "state",
          "createdAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "x-aegis-error-codes": {
    "INVALID_REQUEST": {
      "status": 400,
      "meaning": "Malformed, missing, unsupported currency, nonpositive/out-of-range amount/quantity, or unexpected fields."
    },
    "NOTIFICATION_ID_REUSED": {
      "status": 409,
      "meaning": "Same notificationId, different semantic purchaseId/kind; stored receipt unchanged."
    },
    "UNSUPPORTED_MEDIA_TYPE": {
      "status": 415,
      "meaning": "Request media type must be application/json."
    },
    "INTERNAL_ERROR": {
      "status": 500,
      "meaning": "Unexpected internal failure."
    },
    "SERVICE_UNAVAILABLE": {
      "status": 503,
      "meaning": "Storage/dependency unavailable. A mutation outcome may be unknown; resolve with its original identity."
    },
    "NOTIFICATION_NOT_FOUND": {
      "status": 404,
      "meaning": "Resource does not exist; absence does not fence a delayed mutation."
    }
  }
}
